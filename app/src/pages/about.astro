---
import BaseLayout from "../layouts/BaseLayout.astro";

import ContactCTA from "../components/ContactCTA.astro";
import Hero from "../components/Hero.astro";
---

<BaseLayout
  title="À propos | Christ Mbombo Mokonda"
  description="Découvrez le parcours, l'approche et les compétences de Christ Mbombo Mokonda, développeur Full-Stack freelance spécialisé en Java, Spring Boot et React."
>
  <div class="stack gap-20">
    <main class="wrapper about">
      <Hero
        title="À propos"
        tagline="Développeur Full-Stack freelance spécialisé en Java, Spring Boot et React."
      />

      <section class="intro">
        <div class="content">
          <p class="lead">
            Je suis <strong>Christ Mbombo Mokonda</strong>, développeur
            Full-Stack basé en Île-de-France.
          </p>

          <p>
            Je développe et fais évoluer des applications web en intervenant
            aussi bien sur le back-end que sur le front-end. Mon expérience
            professionnelle m'a principalement amené à travailler avec
            <strong>Java, Spring Boot, React et MySQL</strong>, dans des
            environnements où la qualité du code, la fiabilité et la
            maintenabilité sont essentielles.
          </p>

          <p>
            J'ai également eu l'occasion de travailler sur des problématiques
            d'intégration d'API, de données sensibles, de tests, de CI/CD et de
            choix techniques. Ces expériences m'ont permis de développer une
            approche pragmatique : comprendre le besoin, proposer une solution
            adaptée et aller jusqu'à sa mise en œuvre.
          </p>
        </div>
      </section>

      <section>
        <div class="section-heading">
          <span>01</span>
          <h2>Mon approche</h2>
        </div>

        <div class="cards">
          <article class="card">
            <span class="number">01</span>
            <h3>Développer</h3>
            <p>
              Concevoir et développer des fonctionnalités robustes sur les
              couches front-end et back-end, avec une attention particulière
              portée à la lisibilité et à la maintenabilité du code.
            </p>
          </article>

          <article class="card">
            <span class="number">02</span>
            <h3>Intégrer</h3>
            <p>
              Concevoir des API REST et intégrer des services externes dans des
              applications métier en prenant en compte les contraintes
              techniques et de sécurité.
            </p>
          </article>

          <article class="card">
            <span class="number">03</span>
            <h3>Garantir la qualité</h3>
            <p>
              Mettre en place des tests, documenter les solutions et utiliser
              les outils adaptés pour sécuriser les évolutions d'une
              application.
            </p>
          </article>

          <article class="card">
            <span class="number">04</span>
            <h3>Collaborer</h3>
            <p>
              Travailler efficacement avec les développeurs, QA et équipes
              produit afin de transformer un besoin métier en solution concrète.
            </p>
          </article>
        </div>
      </section>

      <section>
        <div class="section-heading">
          <span>02</span>
          <h2>Stack principale</h2>
        </div>

        <div class="stack-list">
          <div class="stack-group">
            <h3>Back-end</h3>
            <p>Java 17 · Spring Boot · Hibernate · JPA · API REST</p>
          </div>

          <div class="stack-group">
            <h3>Front-end</h3>
            <p>React · JavaScript · TypeScript · HTML · CSS</p>
          </div>

          <div class="stack-group">
            <h3>Base de données</h3>
            <p>MySQL · PostgreSQL</p>
          </div>

          <div class="stack-group">
            <h3>Outils & CI/CD</h3>
            <p>Git · GitLab · Jenkins · Docker · Maven</p>
          </div>

          <div class="stack-group">
            <h3>Tests & documentation</h3>
            <p>JUnit · Jest · Swagger / OpenAPI</p>
          </div>
        </div>
      </section>

      <section>
        <div class="section-heading">
          <span>03</span>
          <h2>Formation</h2>
        </div>

        <div class="education">
          <div class="education-item">
            <div>
              <h3>Master Ingénierie du Web</h3>
              <p>ESGI Paris</p>
            </div>
            <span>2021 — 2023</span>
          </div>

          <div class="education-item">
            <div>
              <h3>Licence Informatique</h3>
              <p>Université Paris 8</p>
            </div>
            <span>2015 — 2019</span>
          </div>
        </div>
      </section>
    </main>

    <ContactCTA />
  </div>
</BaseLayout>

<style>
  .about {
    display: flex;
    flex-direction: column;
    gap: 5rem;
  }

  section {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .intro {
    max-width: 70ch;
    margin-inline: auto;
  }

  .content {
    color: var(--gray-200);
    font-size: var(--text-lg);
    line-height: 1.7;
  }

  .content p + p {
    margin-top: 1.5rem;
  }

  .lead {
    font-size: var(--text-2xl);
    line-height: 1.3;
    color: var(--gray-0);
  }

  .section-heading {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    border-bottom: 1px solid var(--gray-800);
    padding-bottom: 1rem;
  }

  .section-heading span {
    font-family: var(--font-brand);
    font-size: var(--text-sm);
    color: var(--accent);
  }

  .section-heading h2 {
    margin: 0;
  }

  .cards {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
  }

  .card {
    padding: 1.75rem;
    border: 1px solid var(--gray-800);
    border-radius: 1rem;
    background: var(--gray-900);
  }

  .number {
    display: block;
    margin-bottom: 1.5rem;
    color: var(--gray-500);
    font-family: var(--font-brand);
    font-size: var(--text-sm);
  }

  .card h3 {
    margin-bottom: 0.75rem;
  }

  .card p {
    margin: 0;
    color: var(--gray-300);
    line-height: 1.6;
  }

  .stack-list {
    display: flex;
    flex-direction: column;
    border-top: 1px solid var(--gray-800);
  }

  .stack-group {
    display: grid;
    grid-template-columns: 30% 1fr;
    gap: 2rem;
    padding: 1.25rem 0;
    border-bottom: 1px solid var(--gray-800);
  }

  .stack-group h3 {
    margin: 0;
    font-size: var(--text-base);
  }

  .stack-group p {
    margin: 0;
    color: var(--gray-300);
  }

  .education {
    display: flex;
    flex-direction: column;
    border-top: 1px solid var(--gray-800);
  }

  .education-item {
    display: flex;
    justify-content: space-between;
    gap: 2rem;
    padding: 1.5rem 0;
    border-bottom: 1px solid var(--gray-800);
  }

  .education-item h3 {
    margin: 0 0 0.35rem;
  }

  .education-item p,
  .education-item span {
    margin: 0;
    color: var(--gray-400);
  }

  .freelance {
    padding: 3rem;
    border: 1px solid var(--gray-800);
    border-radius: 1.5rem;
    background: var(--gradient-subtle);
  }

  .freelance-content {
    max-width: 60ch;
  }

  .eyebrow {
    font-family: var(--font-brand);
    font-size: var(--text-sm);
    color: var(--accent);
  }

  .freelance h2 {
    margin: 0.75rem 0 1rem;
  }

  .freelance p {
    margin-bottom: 1.5rem;
    color: var(--gray-300);
    font-size: var(--text-lg);
    line-height: 1.6;
  }

  .button {
    display: inline-flex;
    padding: 0.75rem 1.25rem;
    border-radius: 0.5rem;
    background: var(--gray-0);
    color: var(--gray-900);
    font-family: var(--font-brand);
    font-weight: 600;
    text-decoration: none;
    transition: transform var(--theme-transition);
  }

  .button:hover,
  .button:focus {
    transform: translateY(-2px);
  }

  @media (max-width: 50em) {
    .about {
      gap: 3.5rem;
    }

    .cards {
      grid-template-columns: 1fr;
    }

    .stack-group {
      grid-template-columns: 1fr;
      gap: 0.5rem;
    }

    .education-item {
      flex-direction: column;
      gap: 0.5rem;
    }

    .freelance {
      padding: 2rem;
    }
  }
</style>
